# Set the final public address before deployment, for example https://blog.example.com
SITE_URL=http://localhost:3000
# Only required if the Prismic Content API is private.
PRISMIC_ACCESS_TOKEN=
# Generate a random value and use the same value in your Prismic webhook settings.
PRISMIC_WEBHOOK_SECRET=
# Optional: prevent indexing on a staging server.
DISABLE_INDEXING=false
